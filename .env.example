# PostgreSQL
POSTGRES_DB=clinguard
POSTGRES_USER=clinguard_app
POSTGRES_PASSWORD=replace_with_a_strong_password

# OpenRouter LLM
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace_with_your_key
OPENROUTER_MODEL=qwen/qwen3.7-plus

# Embeddings
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSION=2000

# Authentication — replace all placeholders
CLINGUARD_JWT_SECRET=replace_with_a_long_random_secret
CLINGUARD_CLINICIAN_PASSWORD=replace_with_a_strong_clinician_password
CLINGUARD_ADMIN_PASSWORD=replace_with_a_strong_admin_password
